{
  "name": "@stoplight/webpack",
  "version": "2.7.0",
  "description": "Webpack helpers, built on top of webpack-chain.",
  "keywords": [
    "webpack",
    "webpack-chain"
  ],
  "main": "dist/index.js",
  "sideEffects": false,
  "homepage": "https://github.com/stoplightio/webpack",
  "bugs": "https://github.com/stoplightio/webpack/issues",
  "author": "Stoplight <support@stoplight.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/stoplightio/webpack.git"
  },
  "license": "Apache-2.0",
  "files": [
    "**/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "sl-scripts build",
    "build.docs": "sl-scripts build && sl-scripts bundle",
    "commit": "git-cz",
    "lint": "tslint -c tslint.json 'src/**/*.ts?'",
    "lint.fix": "yarn lint --fix",
    "release": "sl-scripts release",
    "release.docs": "sl-scripts release:docs",
    "release.dryRun": "sl-scripts release --dry-run --debug",
    "test": "jest",
    "test.prod": "yarn lint && yarn test --coverage --maxWorkers=2",
    "test.update": "yarn test --updateSnapshot",
    "test.watch": "yarn test --watch",
    "postbuild": "cp src/index.html dist/index.html",
    "push.yalc": "yarn build && cd dist && yalc push",
    "prepare": "husky"
  },
  "resolutions": {
    "json-schema": "0.4.0",
    "**/json-schema": "0.4.0",
    "form-data": "2.5.6",
    "**/request/form-data": "2.5.6",
    "**/node-gyp/request/form-data": "2.5.6",
    "pbkdf2": "3.1.5",
    "**/pbkdf2": "3.1.5",
    "**/crypto-browserify/pbkdf2": "3.1.5",
    "loader-utils": "2.0.4",
    "**/loader-utils": "2.0.4",
    "style-loader/loader-utils": "2.0.4",
    "babel-loader/loader-utils": "2.0.4",
    "handlebars": "4.7.9",
    "**/handlebars": "4.7.9",
    "minimist": "1.2.8",
    "**/minimist": "1.2.8",
    "property-expr": "2.0.5",
    "**/property-expr": "2.0.5",
    "simple-git": "3.36.0",
    "**/simple-git": "3.36.0",
    "create-hash": "1.2.0",
    "**/create-hash": "1.2.0",
    "ejs": "3.1.10",
    "**/ejs": "3.1.10",
    "lodash": "4.18.1",
    "**/lodash": "4.18.1",
    "ajv": "6.14.0",
    "**/ajv": "6.14.0",
    "qs": "6.15.2",
    "**/qs": "6.15.2",
    "tar": "7.5.19",
    "**/tar": "7.5.19",
    "brace-expansion": "1.1.16",
    "**/brace-expansion": "1.1.16",
    "dompurify": "^3.4.9",
    "**/dompurify": "^3.4.9",
    "tmp": "0.2.7",
    "**/tmp": "0.2.7",
    "braces": "3.0.3",
    "highlight.js": "10.7.3",
    "semver-regex": "3.1.4",
    "shell-quote": "^1.9.0",
    "ssri": "6.0.2",
    "marked": "4.0.12",
    "trim-newlines": "3.0.1",
    "merge": "2.1.1",
    "dot-prop": "5.2.0",
    "http-cache-semantics": "4.1.1",
    "cross-spawn": "6.0.6",
    "semver": "7.5.2",
    "webpack-dev-middleware": "5.3.4",
    "http-proxy-middleware": "2.0.10",
    "node-forge": "1.4.0",
    "serialize-javascript": "^7.0.5",
    "ip": "npm:neoip@2.1.0",
    "micromatch": "4.0.8",
    "postcss": "^8.5.10",
    "got": "11.8.5",
    "tough-cookie": "4.1.3",
    "yaml": "^2.8.3",
    "follow-redirects": "1.16.0",
    "ws": "^8.21.0",
    "uuid": "11.1.1",
    "**/uuid": "11.1.1",
    "npm/uuid": "11.1.1",
    "**/npm/uuid": "11.1.1",
    "fast-xml-parser": "^5.7.0",
    "js-yaml": "^4.2.0",
    "**/@babel/core": "^7.29.7",
    "@babel/core": "^7.29.7",
    "sigstore": "4.1.1",
    "**/sigstore": "4.1.1",
    "@sigstore/core": "^3.2.1",
    "**/@sigstore/core": "^3.2.1"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@types/history": "^4.7.3",
    "babel-loader": "^10.0.0",
    "cache-loader": "^4.1.0",
    "clean-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "13.0.0",
    "cross-env": "^6.0.3",
    "css-loader": "^3.2.1",
    "file-loader": "^4.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-webpack-plugin": "^5.6.3",
    "http-proxy-middleware": "2.0.10",
    "monaco-editor-webpack-plugin": "^1.7.0",
    "path": "^0.12.7",
    "style-loader": "^1.0.1",
    "stylus": "^0.54.7",
    "stylus-loader": "^3.0.2",
    "ts-loader": "^9.1.0",
    "tslint": "^5.20.1",
    "url-loader": "^2.2.0",
    "uuid": "11.1.1",
    "webpack": "^5.101.0",
    "webpack-bugsnag-plugins": "^2.2.3",
    "webpack-bundle-analyzer": "^3.6.0",
    "webpack-chain": "^6.0.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1",
    "webpackbar": "^7.0.0",
    "worker-loader": "^2.0.0"
  },
  "devDependencies": {
    "@stoplight/scripts": "^10.0.0",
    "@types/copy-webpack-plugin": "^5.0.3",
    "@types/jest": "^29.0.0",
    "@types/minimatch": "^3.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^12.12.14",
    "browserfs": "*",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "monaco-editor": "*",
    "ts-jest": "^29.0.0",
    "tslint-config-stoplight": "^1.4.0",
    "typescript": "4.9.5"
  },
  "lint-staged": {
    "*.ts": [
      "yarn lint.fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release": {
    "extends": "@stoplight/scripts/release"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
